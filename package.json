{
  "name": "dsh-cpa-status",
  "version": "0.1.3",
  "description": "CPA account-pool status panel for DeepSeek Harness: sidebar health light, quota bars, success-rate ticks, and gateway key endings",
  "type": "module",
  "license": "Apache-2.0",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cliproxyapi",
    "cpa",
    "status-panel"
  ],
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "SECURITY.md",
    "CHANGELOG.md",
    "docs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/j2st1n/dsh-cpa-status.git"
  },
  "homepage": "https://github.com/j2st1n/dsh-cpa-status#readme",
  "bugs": "https://github.com/j2st1n/dsh-cpa-status/issues",
  "engines": {
    "node": ">=20"
  }
}
